# system_server.te

allow system_server proc_last_kmsg:file r_file_perms;

# /sys/devices/platform/soc/soc:qcom,msm-ext-disp/extcon/extcon0/state
allow system_server sysfs_graphics:file { read getattr open };

# GPU kernel manager
allow system_server vendor_sysfs_kgsl:dir r_dir_perms;
allow system_server vendor_sysfs_kgsl:file rw_file_perms;
allow system_server vendor_sysfs_kgsl:lnk_file r_file_perms;
allow system_server vendor_sysfs_kgsl_gpuclk:file r_file_perms;
